---
import Default from '../layouts/Default.astro';
import BannerPage from '../components/BannerPage.astro';
import SideBySideFloating from '../components/SideBySideFloating.astro';
import ContentTextList from '../components/ContentTextList.astro';
import Statistics from '../components/Statistics.astro';
import ContentText2Col from '../components/ContentText2Col.astro';
import Video from '../components/Video.astro';
import ComboStandard from '../components/ComboStandard.astro';

const pageTitle = 'Why KMECO? | KMECO';

const bannerData = {
  title: 'Why KMECO?'
}

const sbsFloatingData = {
  eyebrow: 'trust and experience',
  heading: 'Partner with KMECO and see why others have trusted our service for over 40 years.',
  content: '<p>When you partner with KMECO, you\'re choosing four decades of dedicated service from a company built on a solid foundation of family values. Our expertise extends beyond standard electrical work, encompassing complex SCADA systems and commercial installations. We manage all projects, large or small, with unmatched professionalism and meticulous attention to detail.</p>',
  cta: {
    ctaLabel: '',
    ctaHref: ''
  },
  image: {
    src: '../images/why-kmeco-sbs-floating.jpg',
    altText: ''
  }
}

const textListData = {
  content: '<p>We understand that selecting an electrical contractor is a crucial decision. KMECO is not only fully licensed and insured, but also deeply committed to the communities we serve. Our technicians are easy to work with and uphold the highest standards of clean, ethical practice. We combine our 40+ years of experience with modern equipment—including our crane and bucket trucks—to ensure your project is completed safely, efficiently, and correctly the first time. We strive to be your trusted, long-term partner.</p>',
  list: [
    'KMECO is committed to doing the job right',
    'We pride ourselves on being ethical in pricing and communicating with our clients',
    'Our values keep up clean cut and free of tobacco, alcohol, and drug use'
  ]
}

const statisticsData = {
  eyebrow: 'company statistics',
  heading: 'Proven experience by the numbers.',
  content: 'The numbers don\'t lie. KMECO has the experience and team to get your project done right.',
  stats: [
    {
      value: '8+',
      label: 'Techs'
    },
    {
      value: '40+',
      label: 'Years Experience'
    }
  ]
}

const text2ColData = {
  content: '<p>Our inventory and diverse equipment allows us to execute nearly every project in-house without excessive reliance on external contractors. Our combined experience ensures rapid, effective service. This dedication to self-sufficiency means we can meet demanding timelines efficiently.</p><p>The cumulative experience from our highly-skilled techs gives us a distinct advantage in solving problems and designing reliable electrical and control systems. We tackle challenges with proven methodologies.</p><p>With over 40 years of service, KMECO maintains an excellent safety record, paramount on every job site. We continuously invest in training and technology to protect our team and your property. Our commitment to clear communication and ethical pricing ensures you always know what to expect, cementing our reputation as a trustworthy partner in Central Utah.</p>'
}

const videoData = {
  videoURL: 'https://www.youtube.com/embed/u1KC9ssyNUk'
}

const comboStandardData = {
  eyebrow: 'mission and values',
  heading: 'What We Value',
  caption: 'At KMECO, we’re more than just an electrical company. We’re a family built on values integrity and hard-work.',
  keyPoints: [
    {
      heading: 'Integrity in All We Do',
      content: 'We stand by our work and our word.'
    },
    {
      heading: 'Hard Work',
      content: 'Expect our team to give 100% effort, every day.'
    }
  ],
  imageLeft: {
    src: '../images/why-kmeco-combo-standard-left.jpg',
    altText: ''
  },
  imageRight: {
    src: '../images/why-kmeco-combo-standard-right.jpg',
    altText: ''
  }
}
---

<Default pageTitle={pageTitle}>
  <BannerPage componentData={bannerData}></BannerPage>
  <SideBySideFloating componentData={sbsFloatingData}></SideBySideFloating>
  <ContentTextList componentData={textListData}></ContentTextList>
  <Statistics componentData={statisticsData}></Statistics>
  <ContentText2Col componentData={text2ColData}></ContentText2Col>
  <!-- <Video componentData={videoData}></Video> -->
  <ComboStandard componentData={comboStandardData}></ComboStandard>
</Default>