---
import Default from '../layouts/Default.astro';
import ContactUs from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = 'Contact Us | KMECO';

const contactData = {
  eyebrow: 'Send us a message',
  heading: 'Drop Us a Line!',
  content: 'We would love to talk with you further about your project or other ways we can serve you. Use the form provided here to securely reach our team. We review each message and respond as soon as possible.',
  instruction: 'Send us a message and we\'ll be in touch.',
  icon: {
    src: 'https://placehold.co/52x52',
    altText: ''
  }
}

const faqData = {
  eyebrow: 'questions and answers',
  heading: 'What Can We  Answer For You?',
  image: {
    src: '../images/contact-faq.jpg',
    altText: ''
  },
  faq: [
    {
      heading: 'What are your project lead and turnaround times?',
      content: '<p>Our project timelines are determined by the scope, material lead times, and permitting requirements. For a specific estimate, please contact us directly so we can fully assess your unique needs.</p>'
    },
    {
      heading: 'What are KMECO\'s licenses?',
      content: '<p><span class="text-red">UT:</span> Contractor 339487-5501, E200-General Electrical, E100-General Engineering, B100-General Building.</p><p><span class="text-red">AZ:</span> CR-11: ROC 339049</p><p><span class="text-red">CO:</span> DORA EC.0102951 Electrical Contractor</p><p><span class="text-red">WY:</span> License Number M-53104</p>'
    }
  ]
}
---

<Default pageTitle={pageTitle}>
  <ContactUs componentData={contactData}></ContactUs>
  <FAQ componentData={faqData}></FAQ>
</Default>