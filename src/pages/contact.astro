---
import Default from '../layouts/Default.astro';
import ContactUs from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';

const pageTitle = 'Contact Us | KMECO';

const contactData = {
  eyebrow: 'Send us a message',
  heading: 'Drop Us a Line!',
  content: 'Lorem ipsum dolor sit amet consectetur. Odio mattis commodo sem morbi nunc. Duis nunc libero id elementum amet tellus arcu metus enim. Hendrerit porttitor aliquam imperdiet egestas egestas sed mauris eu. Donec venenatis etiam dolor orci feugiat.',
  instruction: 'Lorem ipsum dolor sit amet consectetur.',
  icon: {
    src: 'https://placehold.co/52x52',
    altText: ''
  }
}

const faqData = {
  eyebrow: 'questions and answers',
  heading: 'What Can We  Answer For You?',
  image: {
    src: '../images/contact-faq.jpg',
    altText: ''
  },
  faq: [
    {
      heading: 'What are your project lead and turnaround times?',
      content: '<p>Our project timelines are determined by the scope, material lead times, and permitting requirements. For a specific estimate, please contact us directly so we can fully assess your unique needs.</p>'
    },
  ]
}
---

<Default pageTitle={pageTitle}>
  <ContactUs componentData={contactData}></ContactUs>
  <FAQ componentData={faqData}></FAQ>
</Default>