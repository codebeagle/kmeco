---
import { Picture } from 'astro:assets';

const {componentData} = Astro.props;
const images = import.meta.glob('../images/*');
---
<section class="container grid grid-cols-1 xl:grid-cols-12 gap-5 px-5 xl:px-0 py-10 xl:py-15">
  <div class="xl:col-start-2 xl:col-span-10 xl:row-span-1 flex flex-col xl:flex-row xl:items-end justify-between mb-10 xl:mb-15">
    <div class="flex flex-col lg:w-150">
      <p set:html={componentData.eyebrow} class="eyebrow text-red"></p>
      <h2 set:html={componentData.heading} class="heading-200"></h2>
    </div>
    <p class="xl:text-right xl:w-130">{componentData.caption}</p>
  </div>
  <div class="xl:row-start-2 xl:row-span-1 xl:col-start-2 xl:col-span-3 flex flex-col justify-end gap-5 xl:gap-10">
    {componentData.keyPoints.map((point) => 
      <div class="key-point">
        <h3 class="heading-500">{point.heading}</h3>
        <hr class="my-3 border-dark-200">
        <p>{point.content}</p>
      </div>
    )}
  </div>
  <div class="xl:row-start-2 xl:row-span-1 xl:col-start-6 xl:col-span-6 h-50 xl:h-100 flex gap-5 xl:ml-15 items-stretch">
    <Picture class="h-full flex-1 object-cover object-center rounded-xl" src={images[componentData.imageLeft.src]()} formats={['avif','webp']} alt="" />
    <Picture class="h-full flex-1 object-cover object-center rounded-xl" src={images[componentData.imageRight.src]()} formats={['avif','webp']} alt="" />
  </div>
</section> 