---
const {componentData} = Astro.props;
---
<section class="container px-5 my-10 lg:my-15">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-center">
    <div set:html={componentData.content} class="content lg:col-start-2 lg:col-span-5"></div>
    <ul class="list-disc lg:col-start-7 lg:col-span-5 flex flex-col gap-4">
      {componentData.list.map((item) => 
        <li class="heading-600">{item}</li>
      )}
    </ul>
  </div>
</section>