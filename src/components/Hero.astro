---
import { Picture } from 'astro:assets';
import Button from './subcomponents/Button.astro';

const {componentData} = Astro.props;
const images = import.meta.glob('../images/*');
---
<section class="bg-dark-100 w-full px-5 py-10 lg:py-15 overflow-hidden">
  <div class="container mx-auto">
    
    <!-- START: main image -->
    <div class="flex flex-col justify-end mb-10 lg:mb-15 p-8 bg-center bg-no-repeat rounded-xl min-h-[480px] lg:min-h-[540px] overflow-hidden relative text-white">
      
      <Picture class="absolute object-cover object-center left-0 top-0 h-full w-full z-0" src={images[componentData.image.src]()} formats={['avif','webp']} alt="simple KMECO logo" />
      <div class="absolute top-0 left-0 min-h-full min-w-full z-1 bg-linear-to-t from-dark-800 to-transparent"></div>
      
      <div class="grid grid-cols-1 xl:grid-cols-12 auto-rows-max content-end gap-5">
        <div class="xl:col-span-7 content-end z-2">
          <p set:html={componentData.eyebrow} class="eyebrow text-red"></p>
          <h1 set:html={componentData.heading} class="heading-display"></h1>
        </div>
        <div class="xl:col-start-9 xl:col-span-4 content-end flex flex-col gap-5 z-2">
          <p set:html={componentData.content}></p>
          <Button subComponentData={componentData.cta}></Button>
        </div>
      </div>
    
    </div>
    <!-- END: main image -->
    
    <!-- START: cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 px-8"> 
      {componentData.cards.map((card) => 
        <div class="card">
        <h3 class="heading-500">{card.cardHeading}</h3>
          <hr class="my-2 xl:my-4 border-dark-200">
          <p>{card.cardContent}</p>
        </div>
      )}
    </div>

  </div>
</section>