---
import { Picture } from 'astro:assets';
import Button from './subcomponents/Button.astro';

const {componentData} = Astro.props;
const images = import.meta.glob('../images/*');
---
<section class="container px-5 lg:px-0 py-10 lg:py-25 overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
    
    <!-- START: images -->
    <div class="lg:col-start-2 lg:col-span-5 flex flex-col gap-5 xl:pr-5">
      <div class="md:pr-15">
        <Picture class="object-cover object-center h-60 lg:h-auto rounded-xl col-span-2" src={images[componentData.imageLarge.src]()} formats={['avif','webp']} alt="simple KMECO logo" />
      </div> 
      <div class="flex-1 flex flex-row md:items-end gap-5">
        <div class="flex-1 self-stretch flex flex-col items-center justify-center bg-red rounded-xl text-white p-5 md:border-b-4 md:border-white">
          <p class="heading-400">{componentData.stat.number}</p>
          <p class="text-center">{componentData.stat.label}</p>
        </div>
        <Picture class="rounded-xl object-cover object-center md:mt-[-120px] xl:max-w-100 h-40 md:h-60 lg:h-auto md:border-4 md:border-white" src={images[componentData.imageSmall.src]()} formats={['avif','webp']} alt="simple KMECO logo" />
      </div>
    </div>
    <!-- END: images -->
    
    <!-- START: content -->
    <div class="lg:col-start-7 lg:col-span-5 flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <p set:html={componentData.eyebrow} class="eyebrow text-red"></p>
        <h2 set:html={componentData.heading} class="heading-200"></h2>
      </div>
      <div set:html={componentData.content}  class="content"></div>
      <ul class="list-disc">
        {componentData.list.map((item:string) => 
          <li><p>{item}</p></li>
        )}
      </ul>
      <Button subComponentData={componentData.cta}></Button>
    </div>
    <!-- END: content -->

  </div>
</section>