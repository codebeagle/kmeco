---
import { Picture } from 'astro:assets';

const {componentData} = Astro.props;
const images = import.meta.glob('../images/*');
---
<section class="w-full relative bg-dark-800 pt-0 xl:pt-25 pb-10 xl:pb-25">
  <div class="xl:absolute top-0 left-0 h-[300px] xl:h-full z-0 xl:w-[50vw] overflow-hidden">
    <Picture class="object-cover min-h-full max-h-full" src={images[componentData.image.src]()} formats={['avif','webp']} alt="simple KMECO logo" />
  </div>
  <div class="relative container px-5 xl:px-0 mx-auto mt-10 xl:mt-0 z-1">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-5">
      <div class="xl:col-span-5 text-white">
        <p set:html={componentData.eyebrow} class="eyebrow"></p>
        <h2 set:html={componentData.heading} class="heading-200"></h2>
      </div>
      <div class="xl:col-start-8 xl:col-span-4 mt-10 xl:mt-0 text-white">
        <div class="flex flex-col gap-8">
          {componentData.keyPoints.map((point) => 
            <div class="key-point">
              <h3 class="heading-400 mb-2"><i class="fa-light text-red"></i> {point.heading}</h3>
              <p>{point.content}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>