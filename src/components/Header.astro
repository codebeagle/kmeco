---
import { Image } from 'astro:assets';
import KmecoLogo from '../images/kmeco-simple-logo.svg';
import Button from './subcomponents/Button.astro';

const ctaData = {
  ctaLabel: 'Send a Message',
  ctaHref: '/contact'
}
---
<header class="fixed top-0 z-10 flex justify-between w-full border-b border-dark-200 bg-white">
  <div class="flex items-center justify-center p-5 lg:p-10"> 
    <a href="/">
      <Image src={KmecoLogo} alt="Company Logo" width={200} height={50} />
    </a>
  </div>

  <div id="js-mobile-menu" class="hidden xl:flex fixed z-10 top-[88px] lg:top-[122px] xl:top-[auto] flex-1 xl:relative flex flex-col-reverse xl:flex-col items-stretch justify-stretch xl:top-auto xl:border-x xl:border-dark-200 w-full h-[calc(100vh-88px)] xl:h-auto">  

    <div class="flex flex-col flex-col-reverse lg:flex-row gap-5 lg:gap-0 px-10 py-10 xl:py-3 xl:border-b xl:border-dark-200 justify-between bg-red xl:bg-transparent ">  
      <nav class="social">
        <a href="https://www.facebook.com/KMECO.UT" target="_blank" class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-dark-100 p-5">
          <i class="fa-brands fa-facebook"></i>
        </a>
        <a href="https://www.instagram.com/kmeco_pca/" target="_blank" class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-dark-100 p-5">
          <i class="fa-brands fa-instagram"></i>
        </a>
        <!-- <a href="" target="_blank" class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-dark-100 p-5">
          <i class="fa-brands fa-youtube"></i>
        </a> -->
      </nav>
      <div class="flex flex-col xl:flex-row items-start xl:items-center gap-2 xl:gap-0">
        <p class="small text-white xl:text-dark-800"><i class="fa-light fa-phone text-white xl:text-red mr-2"></i>77 West 100 North  P.O. Box #265  Elsinore, UT 84724</p>
        <p class="small xl:border-l xl:border-dark-200 xl:ml-3 xl:pl-3 text-white xl:text-dark-800"><i class="fa-light fa-clock text-white xl:text-red mr-2"></i>M-F: 8:00am - 5:00pm</p>
      </div>
    </div>

    <div class="flex-1 flex items-start xl:items-center justify-between px-10 py-10 xl:py-3 bg-red xl:bg-transparent">
      <nav class="flex flex-col xl:flex-row gap-6 uppercase pb-5 xl:pb-0 w-full">
        <a class="text-white xl:text-red" href="/projects">Projects</a> 
        <a class="text-white xl:text-red" href="/why-kmeco">Why KMECO?</a>
        <!-- <a class="text-white xl:text-red" href="/our-story">Our Story</a> -->
        <!-- <a class="text-white xl:text-red" href="/resources">Resources</a> -->
        <a class="text-white xl:text-red" href="/contact">Contact</a>
      </nav>
      <div class="hidden 2xl:inline whitespace-nowrap">
        <Button subComponentData={ctaData}></Button>
      </div>
    </div>
  
  </div>

  <div class="flex flex-row items-center justify-center gap-3 px-5 lg:px-15 py-5 xl:py-10">
    <span class="hidden sm:inline-flex items-center justify-center w-12 h-12 bg-dark-100 p-5">
      <i class="fa-light fa-phone text-red"></i>
    </span>
    <div class="hidden sm:inline">
      <p class="small color-dark-600">Office Number</p>
      <p>(435) 527-3866</p>
    </div>
    <span id="js-menu-toggle" class="xl:hidden inline-flex items-center justify-center w-12 h-12 bg-red p-5">
      <i id="js-menu-open" class="fa-light fa-bars text-white"></i>
      <i id="js-menu-close" class="fa-light fa-xmark text-white hidden!"></i> 
    </span>
  </div>
</header>